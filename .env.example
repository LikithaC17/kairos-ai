# ==============================================================================
# NetForecast AI / CyberGuard AI — Environment Configuration
# ==============================================================================

# Backend Server Port (defaults to 8000 locally, configured dynamically by Render/cloud)
PORT=8000

# Allowed CORS Origins for FastAPI (comma-separated list)
# Local: http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
# Production: https://YOUR-FRONTEND.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://localhost

# Optional explicit paths to model checkpoints (defaults to <project_root>/checkpoints)
MODEL_PATH=checkpoints/world_model_gru.pt
SCALER_PATH=checkpoints/world_model_scaler.pkl

# Frontend Production API Target URL (used during Vite build for remote backend)
# Local development defaults to /api proxy.
# Production: https://YOUR-BACKEND.onrender.com
VITE_API_URL=
